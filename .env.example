# =============================================================================
# Blog Admin — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values:
#   cp .env.example .env
#
# =============================================================================

# ── Docker Ports ───────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── Admin Credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── TinyMCE API Key ──────────────────────────────────────────────────────────
# Get a free API key at https://www.tiny.cloud/
# Leave empty to use self-hosted fallback (no WYSIWYG editor features)
TINYMCE_API_KEY=

# ── Site URL ─────────────────────────────────────────────────────────────────
# The public-facing URL of the admin panel.
# When running via docker-compose locally, set this to http://localhost:8080
SITE_URL=http://localhost:8080

# ── Data Directory (optional) ────────────────────────────────────────────────
# Where blog post JSON files are stored.
# By default, Docker uses a named volume mounted at /var/www/html/frontend/data
# Override this if you want to use a custom path inside the container.
# DATA_DIR=/var/www/html/frontend/data


# -

